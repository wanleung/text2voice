# Copy to .env and adjust. All settings use the T2V_ prefix.
# T2V_MODEL_DIR=pretrained_models/CosyVoice2-0.5B   # default: pretrained_models/Fun-CosyVoice3-0.5B
# T2V_YUE_MODEL_DIR=pretrained_models/CosyVoice2-Yue-ZoengJyutGaai  # route pure-Cantonese sentences here
# T2V_API_KEY=change-me                             # required when listening on the network
# T2V_DEFAULT_VOICE=hk-female
# T2V_AUTO_CHINESE_LANGUAGE=yue                     # what language="auto" uses for CJK text (yue or zh)
# T2V_MAX_SYNC_CHARS=5000
# T2V_MAX_JOB_CHARS=200000
# T2V_PARAGRAPH_PAUSE_MS=500
# T2V_JOB_TTL_HOURS=0                              # 0 keeps library items until deleted
# T2V_FP16=false
